# Copy to .env.prod on the VPS (git-ignored) and fill in real values.
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.prod ...

POSTGRES_USER=sf
POSTGRES_PASSWORD=change-me-to-a-real-secret
POSTGRES_DB=software_factory

# Optional: only needed if you want the Gemini CLI/managed runtime to work
# in production. Leave blank to skip it entirely.
SF_GEMINI_API_KEY=

# Optional: only needed for the GitHub App integration (connecting real
# repos to projects). Leave all three blank to skip it entirely.
# GITHUB_APP_PRIVATE_KEY must be the .pem contents as ONE line, with real
# newlines replaced by literal \n -- e.g.:
#   GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMII...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
