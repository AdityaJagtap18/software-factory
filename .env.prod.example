# Copy to .env.prod on the VPS (git-ignored) and fill in real values.
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.prod ...

POSTGRES_USER=sf
POSTGRES_PASSWORD=change-me-to-a-real-secret
POSTGRES_DB=software_factory

# Optional: only needed if you want the Gemini CLI/managed runtime to work
# in production. Leave blank to skip it entirely.
SF_GEMINI_API_KEY=
