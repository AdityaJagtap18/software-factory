# "development" is the only value that tolerates the placeholder secrets
# below and the dev-login bypass. Set to "production" (or similar) for any
# shared/non-local deployment -- the app will refuse to start if it still
# finds placeholder secrets or dev-login enabled in that case.
SF_ENVIRONMENT=development
SF_DATABASE_URL=postgresql+psycopg2://sf:sf@localhost:5433/software_factory
SF_JWT_SECRET=dev-secret-change-me
SF_ACCESS_TOKEN_EXPIRE_MINUTES=60
SF_REFRESH_TOKEN_EXPIRE_DAYS=30
SF_CORS_ORIGINS=["http://localhost:4200"]
SF_CREDENTIAL_ENCRYPTION_KEY=dev-credential-key-change-me
SF_NEO4J_URI=bolt://localhost:7688
SF_NEO4J_USER=neo4j
SF_NEO4J_PASSWORD=sfgraphpass123
SF_GITHUB_APP_ID=
SF_GITHUB_APP_PRIVATE_KEY=
SF_GITHUB_WEBHOOK_SECRET=
SF_GITHUB_API_BASE_URL=https://api.github.com
# Local-dev only: shows a "Quick sign in" button on the login screen that
# skips the password for the given account. Leave disabled/blank normally.
SF_DEV_QUICK_LOGIN_ENABLED=false
SF_DEV_QUICK_LOGIN_EMAIL=
